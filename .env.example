# Copy this file to ".env" and fill in your own values. Never commit .env to GitHub.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=foodbank_db
SESSION_SECRET=change-this-to-a-long-random-string

# Email alerts (optional). If SMTP_HOST is empty, alert emails are printed in the
# server console and saved to the Alert Log as "simulated" - perfect for demos/testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Food Bank Alerts <alerts@foodbank.ca>"

# Background jobs (SDD 3.3): AI analysis every 4 h, pickup monitor every 5 min
ENABLE_SCHEDULER=true
# Volunteers may only prepare hampers for pickups inside one of their shifts (Option 1, 3.2)
ENFORCE_SHIFT=true
